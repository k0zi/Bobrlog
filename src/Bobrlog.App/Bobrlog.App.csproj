<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>bobrlog</AssemblyName>
    <RootNamespace>Bobrlog.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\**\*~" />
  </ItemGroup>

  <!-- Localized UI strings: neutral = English, satellite assemblies for hu/fi/de. The typed accessor is generated at build time. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Bobrlog.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="KD.Avalonia.Rice" Version="26.10.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bobrlog.Core\Bobrlog.Core.csproj" />
  </ItemGroup>

  <!-- Bundle the background service next to the app (service/ subfolder) so it can be installed from the UI. -->
  <!-- The service is not a ProjectReference, so restoring the app does not restore it (fresh clones / CI).
       The extra MSBuildRestoreSessionId property gives the restore its own evaluation, so the Publish
       evaluation afterwards sees the freshly generated assets file. -->
  <Target Name="RestoreBundledService">
    <MSBuild Projects="..\Bobrlog.Service\Bobrlog.Service.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration);SelfContained=$(SelfContained);SkipBundleService=true;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
  </Target>

  <Target Name="BundleService" AfterTargets="Build" DependsOnTargets="RestoreBundledService" Condition="'$(SkipBundleService)' != 'true'">
    <MSBuild Projects="..\Bobrlog.Service\Bobrlog.Service.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$([System.IO.Path]::GetFullPath('$(OutDir)'))service/;SelfContained=$(SelfContained);SkipBundleService=true" />
  </Target>

  <Target Name="BundleServiceOnPublish" AfterTargets="Publish" DependsOnTargets="RestoreBundledService" Condition="'$(SkipBundleService)' != 'true'">
    <MSBuild Projects="..\Bobrlog.Service\Bobrlog.Service.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)'))service/;SelfContained=$(SelfContained);SkipBundleService=true" />
  </Target>
</Project>
