<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Bobrlog.App.App"
             xmlns:local="using:Bobrlog.App"
             xmlns:rice="clr-namespace:KD.Avalonia.Rice;assembly=KD.Avalonia.Rice"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFont">Ubuntu Sans, Cantarell, Adwaita Sans, fonts:Inter#Inter</FontFamily>
            <FontFamily x:Key="MonoFont">Ubuntu Sans Mono, Adwaita Mono, DejaVu Sans Mono, monospace</FontFamily>
            <CornerRadius x:Key="CardRadius">10</CornerRadius>

            <ResourceDictionary.ThemeDictionaries>
                <!-- Severity colors (Adwaita-inspired); everything else comes from the selected Rice theme.
                     Error/warning bar pair validated for CVD separation. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SeverityCriticalBrush" Color="#A51D2D" />
                    <SolidColorBrush x:Key="SeverityErrorBrush" Color="#E01B24" />
                    <SolidColorBrush x:Key="SeverityWarningBrush" Color="#C88800" />
                    <SolidColorBrush x:Key="SeverityInfoBrush" Color="#1C71D8" />
                    <SolidColorBrush x:Key="SeverityVerboseBrush" Color="#77767B" />
                    <SolidColorBrush x:Key="BootOkBrush" Color="#26A269" />
                    <SolidColorBrush x:Key="BannerBrush" Color="#FDF0C4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SeverityCriticalBrush" Color="#FF7B63" />
                    <SolidColorBrush x:Key="SeverityErrorBrush" Color="#E01B24" />
                    <SolidColorBrush x:Key="SeverityWarningBrush" Color="#C88800" />
                    <SolidColorBrush x:Key="SeverityInfoBrush" Color="#62A0EA" />
                    <SolidColorBrush x:Key="SeverityVerboseBrush" Color="#9A9996" />
                    <SolidColorBrush x:Key="BootOkBrush" Color="#57E389" />
                    <SolidColorBrush x:Key="BannerBrush" Color="#5C4600" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <rice:RiceStyles />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <Style Selector=":is(Window)">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>

        <Style Selector="PathIcon.severity-critical"><Setter Property="Foreground" Value="{DynamicResource SeverityCriticalBrush}" /></Style>
        <Style Selector="PathIcon.severity-error"><Setter Property="Foreground" Value="{DynamicResource SeverityErrorBrush}" /></Style>
        <Style Selector="PathIcon.severity-warning"><Setter Property="Foreground" Value="{DynamicResource SeverityWarningBrush}" /></Style>
        <Style Selector="PathIcon.severity-info"><Setter Property="Foreground" Value="{DynamicResource SeverityInfoBrush}" /></Style>
        <Style Selector="PathIcon.severity-verbose"><Setter Property="Foreground" Value="{DynamicResource SeverityVerboseBrush}" /></Style>
        <Style Selector="PathIcon.boot-ok"><Setter Property="Foreground" Value="{DynamicResource BootOkBrush}" /></Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource RiceSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RiceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource RiceForegroundMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="CanUserReorderColumns" Value="True" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <!-- Sidebar navigation list -->
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RiceSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RiceAccentBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>
    </Application.Styles>
</Application>
