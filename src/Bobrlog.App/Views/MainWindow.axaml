<rice:RiceWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:r="using:Bobrlog.App.Resources"
                 xmlns:vm="using:Bobrlog.App.ViewModels"
                 xmlns:c="using:Bobrlog.App.Controls"
                 xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls;assembly=KD.Avalonia.Rice"
                 x:Class="Bobrlog.App.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Title="{x:Static r:Strings.App_WindowTitle}"
                 Width="1400" Height="860" MinWidth="900" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ShowThemeSettingsButton="True" ShowAboutButton="True">

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,5" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource RiceBorderBrush}" Background="{DynamicResource RiceSurfaceBrush}">
            <TextBlock Classes="muted" FontSize="12" Text="{Binding SourceText}" />
        </Border>

        <!-- Sidebar: pages, the event lists grouped as sub items, settings in the footer -->
        <rice:RiceSideMenu DockPanel.Dock="Left" ExpandedWidth="250"
                           ItemsSource="{Binding MenuItems}" SelectedItem="{Binding SelectedMenuItem}"
                           IsCollapsed="{Binding IsMenuCollapsed}">
            <rice:RiceSideMenu.Styles>
                <Style Selector="rice|RiceSideMenuItem" x:DataType="vm:NavItem">
                    <Setter Property="Header" Value="{Binding Title}" />
                    <Setter Property="ItemsSource" Value="{Binding Children}" />
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                    <Setter Property="Icon">
                        <Template>
                            <PathIcon Data="{Binding Icon}" Width="16" Height="16" />
                        </Template>
                    </Setter>
                </Style>
            </rice:RiceSideMenu.Styles>
            <rice:RiceSideMenu.Header>
                <StackPanel Spacing="2"
                            IsVisible="{Binding !$parent[rice:RiceSideMenu].IsCollapsed}">
                    <TextBlock Text="{x:Static r:Strings.App_Name}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Classes="muted" FontSize="12" Text="{x:Static r:Strings.App_Subtitle}" />
                </StackPanel>
            </rice:RiceSideMenu.Header>
            <rice:RiceSideMenu.Footer>
                <rice:RiceSideMenuItem Header="{x:Static r:Strings.Settings_Title}"
                                       Command="{Binding ShowSettingsCommand}">
                    <rice:RiceSideMenuItem.Icon>
                        <PathIcon Data="{x:Static c:Icons.Tune}" Width="16" Height="16" />
                    </rice:RiceSideMenuItem.Icon>
                </rice:RiceSideMenuItem>
            </rice:RiceSideMenu.Footer>
        </rice:RiceSideMenu>

        <!-- Content -->
        <DockPanel>
            <rice:RiceInfoBar DockPanel.Dock="Top" Kind="Warning" Margin="16,10,16,0"
                              Message="{Binding PrivilegeWarning}" IsOpen="{Binding HasPrivilegeWarning, Mode=OneWay}" />
            <ContentControl Content="{Binding SelectedPage}" />
        </DockPanel>
    </DockPanel>
</rice:RiceWindow>
