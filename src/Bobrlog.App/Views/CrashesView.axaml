<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="using:Bobrlog.App.Resources"
             xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls;assembly=KD.Avalonia.Rice"
             xmlns:vm="using:Bobrlog.App.ViewModels"
             xmlns:m="using:Bobrlog.Core.Models"
             xmlns:c="using:Bobrlog.App.Controls"
             xmlns:conv="using:Bobrlog.App.Converters"
             x:Class="Bobrlog.App.Views.CrashesView"
             x:DataType="vm:CrashesViewModel">

    <DockPanel Margin="16,12,16,8">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding LoadCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <rice:RiceSpinner IsActive="{Binding IsLoading}" />
                        <TextBlock Text="{x:Static r:Strings.Common_Refresh}" />
                    </StackPanel>
                </Button>
                <TextBlock Classes="h1" Text="{x:Static r:Strings.Crashes_Title}" />
            </DockPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Hint}" />
            <rice:RiceInfoBar Kind="Error" IsClosable="False" Message="{Binding ErrorText}"
                              IsOpen="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <TextBlock Classes="muted" FontSize="12" Text="{Binding StatusText}" VerticalAlignment="Center" />
        </StackPanel>

        <Grid ColumnDefinitions="*,6,420" Margin="0,10,0,0">
            <rice:RiceLoadingOverlay IsActive="{Binding IsLoading}" Message="{Binding StatusText}">
                <DataGrid ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static r:Strings.Col_Time}" Width="175" Binding="{Binding Timestamp, Converter={x:Static conv:Converters.Timestamp}}" x:DataType="m:CrashReport" />
                        <DataGridTextColumn Header="{x:Static r:Strings.Crashes_ColType}" Width="100" Binding="{Binding Kind}" x:DataType="m:CrashReport" />
                        <DataGridTextColumn Header="{x:Static r:Strings.Crashes_ColDescription}" Width="*" Binding="{Binding Title}" x:DataType="m:CrashReport" />
                        <DataGridTextColumn Header="{x:Static r:Strings.Crashes_ColProgram}" Width="220" Binding="{Binding Executable}" x:DataType="m:CrashReport" />
                    </DataGrid.Columns>
                </DataGrid>
            </rice:RiceLoadingOverlay>
            <rice:RiceEmptyState Title="{x:Static r:Strings.Crashes_EmptyTitle}">
                <rice:RiceEmptyState.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!Reports.Count" />
                        <Binding Path="!IsLoading" />
                        <Binding Path="ErrorText" Converter="{x:Static ObjectConverters.IsNull}" />
                    </MultiBinding>
                </rice:RiceEmptyState.IsVisible>
                <rice:RiceEmptyState.Icon>
                    <PathIcon Classes="boot-ok" Data="{x:Static c:Icons.Check}" Width="56" Height="56" />
                </rice:RiceEmptyState.Icon>
            </rice:RiceEmptyState>
            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />
            <Border Grid.Column="2" Classes="card">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="6">
                        <TextBlock Classes="h2" Text="{Binding SelectedReport.Title, FallbackValue={x:Static r:Strings.Crashes_NoneSelected}}" TextWrapping="Wrap" />
                        <SelectableTextBlock Classes="muted" FontSize="12" Text="{Binding SelectedReport.Path, FallbackValue=''}" TextWrapping="Wrap" />
                        <WrapPanel ItemSpacing="6" LineSpacing="6">
                            <Button Content="{x:Static r:Strings.Crashes_EventsThatDay}" Command="{Binding ShowEventsAroundCommand}" />
                            <Button Content="{x:Static r:Strings.Crashes_Copy}" Command="{Binding CopyDetailsCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <ScrollViewer Margin="0,10,0,0">
                        <SelectableTextBlock Classes="mono" FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedReport.Details, FallbackValue=''}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
