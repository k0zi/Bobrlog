// Classification rules. Order matters: the first matching rule wins.
// Fields: id, category, identifiers[], transport, unitPattern, messagePattern (regex, case-insensitive),
//         severity (forced), minSeverity (raise to at least), reason (boot analysis cause), explanation.
// reason and explanation are objects keyed by language code (en, hu, fi, de); "en" is the fallback.
[
  // ───────────── Freezes and crashes (kernel) ─────────────
  {
    "id": "segfault", "category": "Crashes", "transport": "kernel",
    "messagePattern": "segfault at|traps: .* (general protection|trap invalid opcode|trap divide error)",
    "minSeverity": "Warning",
    "explanation": {
      "en": "An application crashed with a memory access violation. This is not a system fault in itself, only a bug in that program.",
      "hu": "Egy alkalmazás memóriahozzáférési hibával összeomlott. Ez önmagában nem rendszerhiba, csak az adott program hibája.",
      "fi": "Sovellus kaatui muistinkäyttövirheeseen. Tämä ei sinänsä ole järjestelmävika, vaan kyseisen ohjelman virhe.",
      "de": "Eine Anwendung ist mit einer Speicherzugriffsverletzung abgestürzt. Das ist an sich kein Systemfehler, sondern nur ein Fehler dieses Programms."
    }
  },
  {
    "id": "kernel-panic", "category": "Crashes", "transport": "kernel",
    "messagePattern": "Kernel panic|kernel BUG at|Oops:|general protection fault|unable to handle (kernel|page)",
    "severity": "Critical",
    "reason": {
      "en": "Kernel crash (panic/oops)",
      "hu": "Kernel összeomlás (panic/oops)",
      "fi": "Ytimen kaatuminen (panic/oops)",
      "de": "Kernel-Absturz (Panic/Oops)"
    },
    "explanation": {
      "en": "The kernel ran into a fatal error. Common causes: a faulty driver (e.g. GPU, Wi-Fi), a memory fault or a kernel bug. The full call chain (Call Trace) is shown in the following entries.",
      "hu": "A kernel végzetes hibába futott. Gyakori ok: hibás driver (pl. GPU, WiFi), memóriahiba vagy kernel-bug. A teljes hívási lánc (Call Trace) a következő bejegyzésekben látható.",
      "fi": "Ydin kohtasi kohtalokkaan virheen. Yleisiä syitä: viallinen ajuri (esim. näytönohjain, WLAN), muistivika tai ytimen bugi. Koko kutsuketju (Call Trace) näkyy seuraavissa merkinnöissä.",
      "de": "Der Kernel ist auf einen fatalen Fehler gestoßen. Häufige Ursachen: ein fehlerhafter Treiber (z. B. GPU, WLAN), ein Speicherfehler oder ein Kernel-Bug. Die vollständige Aufrufkette (Call Trace) steht in den folgenden Einträgen."
    }
  },
  {
    "id": "soft-lockup", "category": "Crashes", "transport": "kernel",
    "messagePattern": "watchdog: BUG: soft lockup|NMI watchdog: .*hard LOCKUP|hard LOCKUP|rcu_(sched|preempt) self-detected stall|rcu: INFO: .*detected stalls",
    "severity": "Critical",
    "reason": {
      "en": "System freeze (CPU lockup / RCU stall)",
      "hu": "Rendszerfagyás (CPU lockup / RCU stall)",
      "fi": "Järjestelmän jumiutuminen (CPU lockup / RCU stall)",
      "de": "Systemhänger (CPU-Lockup / RCU-Stall)"
    },
    "explanation": {
      "en": "A CPU core did not respond for a long time. This typically freezes the machine; it can be caused by a driver bug, a hardware problem or overheating.",
      "hu": "Egy CPU mag hosszú ideig nem reagált. Ez tipikusan a gép lefagyását okozza; oka lehet driver-hiba, hardveres probléma vagy túlmelegedés.",
      "fi": "Prosessoriydin ei vastannut pitkään aikaan. Tämä jumittaa tyypillisesti koneen; syynä voi olla ajurivirhe, laitteistovika tai ylikuumeneminen.",
      "de": "Ein CPU-Kern hat lange Zeit nicht reagiert. Das führt typischerweise zum Einfrieren des Rechners; Ursache kann ein Treiberfehler, ein Hardwareproblem oder Überhitzung sein."
    }
  },
  {
    "id": "hung-task", "category": "Crashes", "transport": "kernel",
    "messagePattern": "INFO: task .* blocked for more than|hung_task",
    "severity": "Error",
    "reason": {
      "en": "Stuck process (hung task) – disk/I/O or a driver is blocking",
      "hu": "Elakadt folyamat (hung task) – lemez/IO vagy driver blokkol",
      "fi": "Jumittunut prosessi (hung task) – levy/I/O tai ajuri estää",
      "de": "Hängender Prozess (hung task) – Datenträger/I/O oder ein Treiber blockiert"
    },
    "explanation": {
      "en": "A process waited in the kernel for 120+ seconds (usually on a disk, network file system or driver operation). When it repeats, it causes freeze-like symptoms.",
      "hu": "Egy folyamat 120+ másodpercig várakozott a kernelben (általában lemez-, hálózati fájlrendszer- vagy driver-művelet). Ismétlődve fagyás-szerű tüneteket okoz.",
      "fi": "Prosessi odotti ytimessä yli 120 sekuntia (yleensä levy-, verkkotiedostojärjestelmä- tai ajuritoimintoa). Toistuessaan se aiheuttaa jumiutumisen kaltaisia oireita.",
      "de": "Ein Prozess hat 120+ Sekunden im Kernel gewartet (meist auf eine Datenträger-, Netzwerkdateisystem- oder Treiberoperation). Wiederholt sich das, entstehen hängerartige Symptome."
    }
  },
  {
    "id": "oom-kill", "category": "Crashes",
    "messagePattern": "Out of memory: Killed process|invoked oom-killer|oom-kill:|Killed process \\d+ .*total-vm",
    "severity": "Error",
    "reason": {
      "en": "Out of memory (OOM killer)",
      "hu": "Elfogyott a memória (OOM killer)",
      "fi": "Muisti loppui (OOM killer)",
      "de": "Speicher erschöpft (OOM-Killer)"
    },
    "explanation": {
      "en": "The system ran out of memory, so the kernel (or systemd-oomd) stopped a process. A memory-hungry application or a memory leak may be behind it.",
      "hu": "A rendszer kifutott a memóriából, ezért a kernel (vagy a systemd-oomd) leállított egy folyamatot. Nagy memóriaigényű alkalmazás vagy memóriaszivárgás állhat a háttérben.",
      "fi": "Järjestelmästä loppui muisti, joten ydin (tai systemd-oomd) lopetti prosessin. Taustalla voi olla paljon muistia vaativa sovellus tai muistivuoto.",
      "de": "Dem System ist der Speicher ausgegangen, daher hat der Kernel (oder systemd-oomd) einen Prozess beendet. Dahinter kann eine speicherhungrige Anwendung oder ein Speicherleck stecken."
    }
  },
  {
    "id": "systemd-oomd", "category": "Crashes", "identifiers": ["systemd-oomd"],
    "messagePattern": "Killed|memory pressure|swap used",
    "minSeverity": "Warning",
    "reason": {
      "en": "systemd-oomd stopped a process because of memory pressure",
      "hu": "A systemd-oomd memórianyomás miatt leállított egy folyamatot",
      "fi": "systemd-oomd lopetti prosessin muistipaineen vuoksi",
      "de": "systemd-oomd hat einen Prozess wegen Speicherdruck beendet"
    },
    "explanation": {
      "en": "systemd-oomd killed an application because of high memory or swap pressure, before the machine slowed down completely.",
      "hu": "A systemd-oomd magas memória- vagy swapnyomás miatt lelőtt egy alkalmazást, mielőtt a gép teljesen belassult volna.",
      "fi": "systemd-oomd lopetti sovelluksen suuren muisti- tai swap-paineen vuoksi ennen kuin kone hidastui täysin.",
      "de": "systemd-oomd hat wegen hohen Speicher- oder Swap-Drucks eine Anwendung beendet, bevor der Rechner völlig ausgebremst wurde."
    }
  },
  {
    "id": "coredump", "category": "Crashes", "identifiers": ["systemd-coredump", "apport", "kernel"],
    "messagePattern": "dumped core|Process \\d+ \\(.*\\) of user \\d+ (dumped core|terminated abnormally)|called for pid \\d+, signal",
    "minSeverity": "Warning",
    "explanation": {
      "en": "A program crashed and a memory image (core dump) or an apport crash report was created.",
      "hu": "Egy program összeomlott és memóriakép (core dump) vagy apport hibajelentés készült róla.",
      "fi": "Ohjelma kaatui, ja siitä luotiin muistivedos (core dump) tai apport-virheraportti.",
      "de": "Ein Programm ist abgestürzt, und es wurde ein Speicherabbild (Core Dump) oder ein apport-Fehlerbericht erstellt."
    }
  },
  {
    "id": "pstore", "category": "Crashes", "identifiers": ["systemd-pstore"],
    "minSeverity": "Warning",
    "reason": {
      "en": "Kernel crash log saved from the previous boot (pstore)",
      "hu": "Előző indításból mentett kernel összeomlás-napló (pstore)",
      "fi": "Edellisestä käynnistyksestä tallennettu ytimen kaatumisloki (pstore)",
      "de": "Aus dem vorherigen Start gesichertes Kernel-Absturzprotokoll (pstore)"
    },
    "explanation": {
      "en": "Before the previous crash, the kernel saved its log to pstore; systemd-pstore has now archived it. Details are under /var/lib/systemd/pstore (root privileges or the background service are required).",
      "hu": "A kernel az előző összeomlás előtt a pstore-ba mentette a naplóját; ezt most archiválta a systemd-pstore. A részletek a /var/lib/systemd/pstore alatt (root jog vagy háttérszolgáltatás kell).",
      "fi": "Ydin tallensi lokinsa pstoreen ennen edellistä kaatumista; systemd-pstore on nyt arkistoinut sen. Tiedot ovat hakemistossa /var/lib/systemd/pstore (vaatii pääkäyttäjän oikeudet tai taustapalvelun).",
      "de": "Der Kernel hat vor dem letzten Absturz sein Protokoll in pstore gesichert; systemd-pstore hat es jetzt archiviert. Details unter /var/lib/systemd/pstore (root-Rechte oder der Hintergrunddienst erforderlich)."
    }
  },
  {
    "id": "watchdog-reset", "category": "Crashes",
    "messagePattern": "watchdog did not stop|Watchdog timeout|hardware watchdog",
    "minSeverity": "Warning",
    "reason": {
      "en": "Hardware watchdog reset",
      "hu": "Hardveres watchdog újraindítás",
      "fi": "Laitteistovahtikoiran uudelleenkäynnistys",
      "de": "Neustart durch Hardware-Watchdog"
    },
    "explanation": {
      "en": "The hardware watchdog timer expired, which can force the machine to restart.",
      "hu": "A hardveres watchdog időzítő lejárt, ami a gép kényszer-újraindítását okozhatja.",
      "fi": "Laitteiston vahtikoira-ajastin laukesi, mikä voi pakottaa koneen uudelleenkäynnistykseen.",
      "de": "Der Hardware-Watchdog-Timer ist abgelaufen, was einen erzwungenen Neustart des Rechners auslösen kann."
    }
  },

  // ───────────── Kernel and hardware ─────────────
  {
    "id": "pcie-aer", "category": "KernelHardware", "transport": "kernel",
    "messagePattern": "AER: |PCIe Bus Error|pcieport .* (error|Uncorrect)",
    "minSeverity": "Warning",
